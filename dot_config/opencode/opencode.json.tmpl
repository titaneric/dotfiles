{{- $isCompanyComputer := dig "opencode" "isCompanyComputer" false . -}}
{{- $model := dig "opencode" "model" "" . -}}
{{- $enabledProviders := list -}}
{{- $providers := list -}}
{{- $providerMap := dict -}}
{{- if $isCompanyComputer -}}
{{- $enabledProviders = dig "opencode" "enabledProviders" list . -}}
{{- $providers = dig "opencode" "providers" list . -}}
{{- range $provider := $providers -}}
{{- if $provider.id -}}
{{- $providerConfig := omit $provider "id" "models" "npm" "api" "options" -}}
{{- if get $provider "npm" -}}
{{- $_ := set $providerConfig "package" (printf "aisdk:%s" (get $provider "npm")) -}}
{{- end -}}
{{- $settings := omit (get $provider "options" | default dict) "headers" "body" -}}
{{- if get $provider "api" -}}
{{- $_ := set $settings "baseURL" (get $provider "api") -}}
{{- end -}}
{{- if $settings -}}
{{- $_ := set $providerConfig "settings" $settings -}}
{{- end -}}
{{- with dig "options" "headers" nil $provider -}}
{{- $_ := set $providerConfig "headers" . -}}
{{- end -}}
{{- with dig "options" "body" nil $provider -}}
{{- $_ := set $providerConfig "body" . -}}
{{- end -}}
{{- $models := get $provider "models" -}}
{{- if $models -}}
{{- $modelMap := dict -}}
{{- range $providerModel := $models -}}
{{- if $providerModel.id -}}
{{- $modelConfig := omit $providerModel "id" "options" "variants" "tool_call" "modalities" "status" -}}
{{- if get $providerModel "options" -}}
{{- $_ := set $modelConfig "settings" (get $providerModel "options") -}}
{{- end -}}
{{- if eq (get $providerModel "status") "deprecated" -}}
{{- $_ := set $modelConfig "disabled" true -}}
{{- end -}}
{{- if get $providerModel "variants" -}}
{{- $variants := list -}}
{{- range $variantID, $variant := get $providerModel "variants" -}}
{{- $variants = append $variants (dict "id" $variantID "settings" $variant) -}}
{{- end -}}
{{- $_ := set $modelConfig "variants" $variants -}}
{{- end -}}
{{- $_ := set $modelMap $providerModel.id $modelConfig -}}
{{- end -}}
{{- end -}}
{{- $_ := set $providerConfig "models" $modelMap -}}
{{- end -}}
{{- $_ := set $providerMap $provider.id $providerConfig -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $mcpServers := list -}}
{{- if and $isCompanyComputer (dig "opencode" "mcp" "enabled" true .) -}}
{{- $mcpServers = dig "opencode" "mcp" "servers" list . -}}
{{- end -}}
{{- $mcpMap := dict -}}
{{- range $server := $mcpServers -}}
{{- if $server.name -}}
{{- $serverConfig := omit $server "name" "enabled" -}}
{{- if hasKey $server "enabled" -}}
{{- $_ := set $serverConfig "disabled" (not $server.enabled) -}}
{{- end -}}
{{- if get $server "timeout" -}}
{{- $_ := set $serverConfig "timeout" (dict "catalog" (get $server "timeout") "execution" (get $server "timeout")) -}}
{{- end -}}
{{- $_ := set $mcpMap $server.name $serverConfig -}}
{{- end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 0
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "but *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl exec *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl debug *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl apply *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" }
  ],
{{- if $model }}
  "model": "{{ $model }}",
{{- end }}
{{- if and $isCompanyComputer $enabledProviders }}
  "experimental": { "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" }{{ range $providerID := $enabledProviders }},
    { "action": "provider.use", "resource": {{ $providerID | toJson }}, "effect": "allow" }{{ end }}
  ] },
{{- end }}
  "plugins": [
    "@devtheops/opencode-plugin-otel",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "/Users/al03160720/.config/opencode/vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
{{- if and $isCompanyComputer $providerMap }}
  "providers": {{ $providerMap | toPrettyJson | trimSuffix "\n" | replace "\n" "\n  " }},
{{- end }}
  "mcp": { "servers": {{ $mcpMap | toPrettyJson | trimSuffix "\n" | replace "\n" "\n  " }} }
}
